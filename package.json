{
  "name": "fpsbone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run build:server && node server/serve.js",
    "dev": "concurrently -n server,client -c cyan,magenta \"node server/serve.js\" \"vite\"",
    "dev:lan": "concurrently -n server,client -c cyan,magenta \"node server/serve.js\" \"vite --host\"",
    "server": "node server/serve.js",
    "client": "vite",
    "build": "vite build",
    "build:server": "vite build --mode selfhost",
    "preview": "vite preview",
    "bot": "node server/bot.js",
    "ids": "node ids.mjs",
    "verify": "node ids.mjs && node verify.mjs",
    "fuzz": "node fuzz.mjs",
    "probe:local": "node probe-local.mjs",
    "probe:modes": "node probe-modes.mjs"
  },
  "dependencies": {
    "three": "^0.169.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^5.4.0"
  }
}
