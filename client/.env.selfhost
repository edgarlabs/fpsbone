# Read by `vite build --mode selfhost` (npm run build:server) and by nothing else.
#
# `origin` means the built client dials a WebSocket back at whatever host served the page,
# which is what server/serve.js is: one process, one port, the client and the game together.
# See the host block at the top of client/src/main.js for how this is read.
#
# The plain `npm run build` deliberately does NOT see this file, because a bundle uploaded to
# a static host has no server behind it to dial — that build falls back to the in-page host in
# client/src/localserver.js, which is the difference between bots-only and a blank
# "connecting…" forever.
VITE_SERVER=origin
